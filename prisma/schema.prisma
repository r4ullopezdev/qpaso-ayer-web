// Prisma schema — Qué Pasó Ayer (web de eventos + restaurante)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Usuarios del panel: ADMIN (todo) o DOOR (solo escáner de puerta)
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("ADMIN") // "ADMIN" | "DOOR"
  createdAt    DateTime @default(now())
}

/// Promotor: capta gente con su link de referido y cobra por persona que entra
model Promoter {
  id           String   @id @default(cuid())
  code         String   @unique // aparece en el link ?ref=CODE
  name         String
  passwordHash String
  active       Boolean  @default(true)
  signups      Signup[]
  createdAt    DateTime @default(now())
}

/// Un evento de la programación (Travelers Night, Main Event, etc.)
model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String?
  description  String?
  subtitleEn   String?
  descriptionEn String?
  motor       String? // Turismo / Universitario / After-work / Fiesta / Social / Lanzamiento
  date        DateTime // fecha + hora de inicio del evento
  startTime   String   @default("22:00") // texto mostrado, ej. "22:00"
  coverImage  String? // ARTE completo (se ve entero en la página del evento)
  cardImage   String? // imagen para la card del listado "Eventos" (formato apaisado)
  published   Boolean  @default(false)
  closed      Boolean  @default(false) // evento pasado / cerrado a inscripciones

  // Lista gratuita (sin pagos): dos listas diferenciadas
  girlsListOpen  Boolean @default(true)
  guysListOpen   Boolean @default(true)
  girlsFreeUntil String  @default("00:00")
  guysFreeUntil  String  @default("23:00")
  girlsCap       Int?
  guysCap        Int?
  girlsListNote  String? // descripción libre (ej. "Gin tonic gratis + copa de bienvenida")
  guysListNote   String?

  // Entrada de pago (se paga en puerta)
  paidEntryOpen Boolean @default(true)
  paidPrice     String  @default("$10")
  paidNote      String? // descripción libre (ej. "Incluye openbar hasta las 12")

  // Mesa para chicas (grupos): requiere código de un solo uso
  girlsTableOpen Boolean @default(true)
  girlsTableMin  Int     @default(4)
  girlsTableNote String?

  signups   Signup[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// Inscripción a un evento (lista gratis, pago en puerta o mesa para chicas)
model Signup {
  id        String  @id @default(cuid())
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  entryType String  @default("FREE") // "FREE" | "PAID" | "TABLE_GIRLS"
  list      String // "CHICAS" | "CHICOS" (para FREE y TABLE_GIRLS = CHICAS)
  name      String
  phone     String?
  email     String
  guests    Int     @default(1)

  // Referido / promotor
  promoter   Promoter? @relation(fields: [promoterId], references: [id], onDelete: SetNull)
  promoterId String?

  // Entrada / QR
  token     String  @unique // va en el QR
  tableCode String? // código de mesa usado (si TABLE_GIRLS)

  // Control de puerta
  checkedIn   Boolean   @default(false)
  checkedInAt DateTime?
  checkedInBy String? // username del portero
  manual      Boolean   @default(false) // registrado a mano por el portero (sin datos de la persona)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([promoterId])
  @@index([checkedInAt])
}

/// Código de un solo uso para "Mesa para chicas". El admin los genera; al usarse desaparece.
model TableCode {
  id            String    @id @default(cuid())
  code          String    @unique
  used          Boolean   @default(false)
  usedAt        DateTime?
  usedBySignup  String? // id del signup que lo consumió
  note          String?
  createdAt     DateTime  @default(now())
}

/// Sección de la carta del restaurante
model MenuSection {
  id      String     @id @default(cuid())
  title   String
  titleEn String?
  order   Int        @default(0)
  items   MenuItem[]
}

model MenuItem {
  id            String      @id @default(cuid())
  section       MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId     String
  name          String
  nameEn        String?
  description   String?
  descriptionEn String?
  price         String?
  featured      Boolean     @default(false)
  image         String?
  order         Int         @default(0)
}

/// Ajustes editables del sitio (clave/valor)
model Setting {
  key   String @id
  value String
}
